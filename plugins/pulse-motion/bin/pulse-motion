#!/usr/bin/env sh
# pulse-motion – outil du plugin Pulse Motion. Claude Code place le dossier bin/ du plugin dans le PATH : les skills
# /pulse-motion:* l'appellent sans chemin ni autorisation de lecture.
# Node.js : celui du PATH, sinon un emplacement connu (installé à l'instant, avant que l'outil ne le voie : spec Retouches
# et ergonomie, 5.6) : Homebrew, /usr/local, la version la plus récente de nvm, et sous Windows (sh de Git) Program Files
# et AppData. PM_NODE_EMPLACEMENTS (chemins séparés par « ; » : un chemin Windows contient « : ») remplace la liste des
# emplacements connus (tests).
# Node absent : un message en français sur la sortie standard (lu aussi par les blocs injectés au lancement des skills),
# code 3 ; pour le rappel de démarrage (« pulse-motion rappel »), un contexte pour Claude, code 0.

trouver_node() {
  if command -v node >/dev/null 2>&1; then command -v node; return 0; fi
  if [ -n "$PM_NODE_EMPLACEMENTS" ]; then
    liste="$PM_NODE_EMPLACEMENTS"
  else
    liste="/opt/homebrew/bin/node;/usr/local/bin/node"
    [ -n "$ProgramFiles" ] && liste="$liste;$ProgramFiles/nodejs/node.exe"
    [ -n "$LOCALAPPDATA" ] && liste="$liste;$LOCALAPPDATA/Programs/nodejs/node.exe"
    # nvm : la version la plus récente (vX.Y.Z comparées par leurs nombres).
    meilleur=""
    cle_max=-1
    for n in "$HOME"/.nvm/versions/node/v*/bin/node; do
      [ -x "$n" ] || continue
      v=${n%/bin/node}
      v=${v##*/v}
      majeure=${v%%.*}
      reste=${v#*.}
      mineure=${reste%%.*}
      correctif=${reste#*.}
      case "$majeure$mineure$correctif" in *[!0-9]*) continue ;; esac
      cle=$((majeure * 1000000 + mineure * 1000 + correctif))
      if [ "$cle" -gt "$cle_max" ]; then cle_max=$cle; meilleur=$n; fi
    done
    [ -n "$meilleur" ] && liste="$liste;$meilleur"
  fi
  ancien_ifs=$IFS
  IFS=";"
  for c in $liste; do
    if [ -n "$c" ] && [ -f "$c" ] && [ -x "$c" ]; then IFS=$ancien_ifs; echo "$c"; return 0; fi
  done
  IFS=$ancien_ifs
  return 1
}

NODE=$(trouver_node)
if [ -z "$NODE" ]; then
  if [ "$1" = "rappel" ]; then
    printf '%s\n' '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"Pulse Motion – Node.js manque sur cet ordinateur : proposer de l'"'"'installer avec l'"'"'accord de la personne (/pulse-motion:outils, étape « Installer Node.js »), avant toute vidéo."}}'
    exit 0
  fi
  echo "Node.js introuvable : « node » n'est pas installé."
  exit 3
fi
# Dossier du relais sans dirname (le PATH peut ne contenir aucun outil).
ICI=${0%/*}
[ "$ICI" = "$0" ] && ICI=.
exec "$NODE" "$ICI/../scripts/pm.js" "$@"
