{
  "version": 1,
  "nom": "metamorphose",
  "description": "L'élément visé (data-ancre) se défait en particules qui se recomposent en un autre élément (data-cible), du centre vers les bords ; les couleurs passent de l'un à l'autre en chemin.",
  "parametres": {
    "densite": { "defaut": 4, "min": 1, "max": 64 },
    "arrivee": { "defaut": 1, "min": 0.2, "max": 1 },
    "echelonnement": { "defaut": 0.3, "min": 0, "max": 1 },
    "tourbillon": { "defaut": 15, "min": 0, "max": 100 }
  },
  "rendu_calque": { "bloom": 0, "tons": "neutre" },
  "emetteurs": [
    {
      "nom": "grain",
      "naissance": {
        "forme": { "type": "pixels", "densite": "densite" }
      },
      "forces": [
        { "type": "turbulence", "echelle": 12, "force": "tourbillon", "vitesse": 0.6 }
      ],
      "cible": { "source": "cible", "arrivee": "choree", "a": "arrivee * dur", "echelonnement": "echelonnement", "ordre": "centre", "densite": "densite", "courbe": "cubic-inout" },
      "vie": { "couleur": "source" },
      "rendu": { "type": "sprite", "texture": "pixel", "melange": "alpha" }
    }
  ]
}
