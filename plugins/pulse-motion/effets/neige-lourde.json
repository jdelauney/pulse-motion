{
  "version": 1,
  "nom": "neige-lourde",
  "description": "Neige lourde et collante qui tombe depuis le haut de l'image et forme de vrais tas sur les obstacles (grains cohésifs) ; calque arrière, plus coûteuse que la neige.",
  "parametres": {
    "nombre": {
      "defaut": 2500,
      "min": 200,
      "max": 20000
    },
    "vitesse": {
      "defaut": 1,
      "min": 0.3,
      "max": 3
    },
    "taille": {
      "defaut": 1,
      "min": 0.5,
      "max": 2
    },
    "couleur": {
      "defaut": "#ffffff",
      "type": "couleur"
    }
  },
  "rendu_calque": {
    "bloom": 0.3
  },
  "emetteurs": [
    {
      "nom": "flocon",
      "naissance": {
        "debit": "nombre / dur",
        "forme": {
          "type": "ligne",
          "largeur": 200,
          "decalage": [
            0,
            -52
          ]
        },
        "vitesse": {
          "direction": [
            0,
            1
          ],
          "cone": 20,
          "valeur": [
            "8 * vitesse",
            "14 * vitesse"
          ]
        },
        "vie": [
          "dur + 8",
          "dur + 8"
        ],
        "taille": [
          "0.6 * taille",
          "0.9 * taille"
        ]
      },
      "forces": [
        {
          "type": "gravite",
          "valeur": "20 * vitesse"
        },
        {
          "type": "trainee",
          "coef": 0.6
        },
        {
          "type": "turbulence",
          "echelle": 12,
          "force": 4,
          "vitesse": 0.5
        }
      ],
      "collisions": {
        "cibles": [
          "sol",
          "elements",
          "formes"
        ],
        "reponse": "rebond",
        "restitution": 0,
        "frottement": 0.8
      },
      "interactions": {
        "type": "grains",
        "rayon": "0.9 * taille",
        "frottement": {
          "statique": 0.9,
          "dynamique": 0.6
        },
        "cohesion": 0.35,
        "restitution": 0
      },
      "vie": {
        "couleur": "couleur"
      },
      "rendu": {
        "type": "sprite",
        "texture": "disque-doux",
        "melange": "alpha"
      }
    }
  ]
}
