{
  "version": 1,
  "nom": "rideau",
  "description": "Rideau qui couvre l'ancre, tenu par son bord haut, et s'ouvre en se déchirant depuis son centre ; poser l'ancre sur ce qu'il cache, data-start au moment du dévoilement.",
  "parametres": {
    "ouverture": { "defaut": 1, "min": 0.2, "max": 3 },
    "resistance": { "defaut": 1.3, "min": 1.1, "max": 2 },
    "couleur": { "defaut": "#8a1c2b", "type": "couleur" }
  },
  "rendu_calque": { "bloom": 0, "tons": "neutre" },
  "emetteurs": [
    {
      "nom": "toile",
      "structure": {
        "type": "tissu",
        "resolution": [32, 24],
        "attaches": [{ "ou": "haut", "a": "ancre" }],
        "raideur": 0.9,
        "flexion": 0.05,
        "amortissement": 0.03,
        "dechirure": "resistance",
        "apparence": { "couleur": "couleur", "lumiere": [-0.3, -1] }
      },
      "forces": [
        { "type": "gravite", "valeur": 30 },
        { "type": "attracteur", "force": "-600 * ouverture", "rayon": 15, "centre": [0.5, 0.75] }
      ]
    }
  ]
}
