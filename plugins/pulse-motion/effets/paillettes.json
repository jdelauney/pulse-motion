{
  "version": 1,
  "nom": "paillettes",
  "description": "Paillettes magiques qui scintillent et montent doucement autour de la zone (mise en valeur, révélation).",
  "parametres": {
    "nombre": { "defaut": 120, "min": 10, "max": 5000 },
    "couleur": { "defaut": "#ffe8a3", "type": "couleur" },
    "eclat": { "defaut": 3, "min": 0.5, "max": 8 },
    "taille": { "defaut": 1, "min": 0.3, "max": 3 }
  },
  "rendu_calque": { "bloom": 2.7, "seuil_bloom": 0.9 },
  "emetteurs": [
    {
      "nom": "paillette",
      "naissance": {
        "debit": "nombre / dur",
        "forme": { "type": "ancre", "zone": "contour" },
        "vitesse": { "direction": [0, -1], "cone": 120, "valeur": [2, 8] },
        "vie": [0.8, 1.8],
        "taille": ["0.8 * taille", "1.8 * taille"],
        "rotation": [0, 45],
        "vitesse_angulaire": [-60, 60]
      },
      "forces": [
        { "type": "gravite", "valeur": -3 },
        { "type": "trainee", "coef": 1.5 },
        { "type": "turbulence", "echelle": 10, "force": 8, "vitesse": 0.6 }
      ],
      "vie": {
        "couleur": "couleur",
        "intensite": { "de": 0, "a": "eclat", "courbe": "wave" },
        "taille": { "de": 0.4, "a": 1, "courbe": "sine-arch" }
      },
      "rendu": { "type": "sprite", "texture": "etoile", "melange": "additif" }
    }
  ]
}
