{
  "description": "Pulse Motion – au démarrage d'une session, rappelle la vidéo en cours dans le dossier et signale un Node.js trop ancien ; un second crochet, par le relais sh (qui cherche Node aussi hors du PATH), signale un Node.js absent ; après l'écriture d'une scène, la contrôle aussitôt.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/rappel.js"
            ],
            "timeout": 10
          },
          {
            "type": "command",
            "command": "sh",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/bin/pulse-motion",
              "rappel-node"
            ],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/scripts/controle-scene.js"
            ],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
