{
  "description": "Pulse Motion – au démarrage d'une session, rappelle la vidéo en cours dans le dossier et signale une version de Node.js trop ancienne ; après l'écriture d'une scène, la contrôle aussitôt.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/rappel.js"],
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/scripts/controle-scene.js"],
            "timeout": 10
          }
        ]
      }
    ]
  }
}
