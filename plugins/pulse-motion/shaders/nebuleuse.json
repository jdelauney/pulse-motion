{
  "version": 1,
  "nom": "nebuleuse",
  "usage": "fond",
  "description": "Nuages de bruit fractal qui dérivent lentement, en deux couleurs de la charte : fond d'ambiance calme (espace, rêverie, idée).",
  "parametres": {
    "vitesse": { "defaut": 0.2, "min": 0, "max": 2 },
    "echelle": { "defaut": 30, "min": 5, "max": 100 },
