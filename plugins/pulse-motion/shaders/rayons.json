{
  "version": 1,
  "nom": "rayons",
  "usage": "fond",
  "description": "Faisceaux de lumière qui tournent lentement autour d'un point : révélation, mise en avant d'un élément central.",
  "parametres": {
    "nombre": { "defaut": 12, "min": 2, "max": 40 },
    "vitesse": { "defaut": 0.1, "min": -2, "max": 2 },
    "intensite": { "defaut": 0.6, "min": 0, "max": 2 },
    "centre_x": { "defaut": 0.5, "min": 0, "max": 1 },
    "centre_y": { "defaut": 0.3, "min": 0, "max": 1 },
    "couleur": { "defaut": "accent", "type": "couleur" }
  }
}
