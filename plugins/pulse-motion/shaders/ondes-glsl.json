{
  "version": 1,
  "nom": "ondes-glsl",
  "usage": "fond",
  "langage": "glsl",
  "description": "Ondes : des gouttes tombent sur une eau calme et leurs ronds se croisent (équation des ondes, en GLSL) ; calme, réflexion, nature.",
  "passes": [{ "nom": "A", "lit": ["A"], "echelle": 0.5 }, { "nom": "image", "lit": ["A"] }],
  "parametres": {
    "intervalle": { "defaut": 1.2, "min": 0.3, "max": 4 },
    "force": { "defaut": 0.8, "min": 0.1, "max": 2 },
    "amortissement": { "defaut": 0.985, "min": 0.9, "max": 0.999 },
    "profondeur": { "defaut": "fond", "type": "couleur" },
    "teinte": { "defaut": "primaire", "type": "couleur" },
    "melange": { "defaut": 0.25, "min": 0, "max": 1 },
    "reflet": { "defaut": "#ffffff", "type": "couleur" },
    "opacite": { "defaut": 1, "min": 0, "max": 1 }
  }
}
