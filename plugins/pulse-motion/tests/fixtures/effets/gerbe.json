{
  "version": 1,
  "nom": "gerbe",
  "description": "Gerbe de test avec sous-émetteur",
  "parametres": {
    "nombre": { "defaut": 100, "min": 10, "max": 1000 },
    "vitesse": { "defaut": 1, "min": 0.5, "max": 2 },
    "couleur": { "defaut": "#ff8800", "type": "couleur" }
  },
  "emetteurs": [
    {
      "nom": "gerbe",
      "naissance": {
        "debit": "nombre / dur",
        "forme": { "type": "ancre", "zone": "contour" },
        "vitesse": { "direction": [0, -1], "cone": 60, "valeur": ["20cqh * vitesse", "40cqh * vitesse"] },
        "vie": [0.5, 1],
        "taille": [0.5, 1]
      },
      "forces": [{ "type": "gravite", "valeur": 40 }, { "type": "trainee", "coef": 1 }],
      "vie": {
        "couleur": { "degrade": ["#ffffff", "couleur"] },
        "taille": { "de": 1, "a": 0, "courbe": "cubic-in" }
      },
      "rendu": { "type": "etincelle", "melange": "additif" },
      "a_la_mort": { "emetteur": "eclat" }
    },
    {
      "nom": "eclat",
      "naissance": { "nombre": 3, "vitesse": { "cone": 360, "valeur": [5, 10] }, "vie": [0.2, 0.4] },
      "forces": [{ "type": "trainee", "coef": 2 }]
    }
  ]
}
